(test
 (name test_cli)
 (modules test_cli)
 (libraries unix)
 (deps ../bin/deco.exe)
 (action
  (run %{test} %{exe:../bin/deco.exe} %{read:../lib/cli/build_version.txt})))

(rule
 (target init_test_support.ml)
 (deps ../lib/commands/init/init.ml)
 (action
  (with-stdout-to
   %{target}
   (progn
    (echo "module Template = Deco.Template\n")
    (cat %{deps})))))

