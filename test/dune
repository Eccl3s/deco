  test_exec_cli
  test_shell_cli
  test_init
  init_test_support
  test_embed_templates)
 (libraries deco config unix otoml yojson))

(test
 (name test_cli)
 (modules test_cli)
 (libraries unix)
 (deps ../bin/deco.exe)
 (action
  (run %{test} %{exe:../bin/deco.exe} %{read:../lib/cli/build_version.txt})))

(rule
 (target init_test_support.ml)
 (deps ../lib/commands/init/init.ml)
 (action
  (with-stdout-to
   %{target}
   (progn
    (echo "module Template = Deco.Template\n")
    (cat %{deps})))))

(test
 (name test_init)
 (modules test_init init_test_support)
 (libraries deco config unix otoml)
 (deps
  (glob_files ../lib/templates/*.Containerfile)
  (glob_files ../lib/templates/*.toml))
 (action
  (run %{test} %{workspace_root}/lib/templates)))

